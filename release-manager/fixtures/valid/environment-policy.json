{
  "apiVersion": "quanyu.ai/environment-policy/v1alpha1",
  "kind": "EnvironmentPolicy",
  "metadata": { "environmentId": "example-demo", "serviceId": "example-web", "application": "example-app" },
  "storage": {
    "releaseRoot": "/var/lib/example/releases/example-app",
    "stateRoot": "/var/lib/example/release-state/example-app",
    "lockFile": "/var/lib/example/release-locks/example-app.lock"
  },
  "process": {
    "adapter": "pm2",
    "namespace": "release-manager-demo",
    "stableName": "demo-example-app",
    "replacement": "stop-absent-start-attest"
  },
  "network": { "internalHost": "127.0.0.1", "internalPort": 3104, "publicBaseUrl": "https://demo.example.invalid" },
  "secrets": {
    "provider": "external-json-file",
    "sourcePath": "/var/lib/example/secrets/example-app/demo.json",
    "requiredNames": ["DATABASE_URL", "JWT_ACCESS_SECRET"]
  },
  "health": { "attempts": 20, "intervalMs": 2000 },
  "retention": { "verifiedReleases": 3, "failedAttempts": 5 }
}
