{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanyu.ai/schemas/state-record/v1alpha1",
  "title": "Release Manager State Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "environmentId", "serviceId", "generation", "updatedAt", "status", "releaseContractDigest", "environmentPolicyDigest", "attempt"],
  "properties": {
    "apiVersion": { "const": "quanyu.ai/state-record/v1alpha1" },
    "kind": { "const": "ReleaseState" },
    "environmentId": { "$ref": "#/$defs/id" },
    "serviceId": { "$ref": "#/$defs/id" },
    "generation": { "type": "integer", "minimum": 1 },
    "updatedAt": { "$ref": "#/$defs/timestamp" },
    "status": {
      "enum": ["unmanaged", "adoption-ready", "candidate-ready", "activating", "managed", "restoring", "failed", "recovery-required"]
    },
    "releaseContractDigest": { "$ref": "#/$defs/digest" },
    "environmentPolicyDigest": { "$ref": "#/$defs/digest" },
    "current": { "$ref": "#/$defs/verifiedRelease" },
    "previous": { "$ref": "#/$defs/verifiedRelease" },
    "legacy": { "$ref": "#/$defs/verifiedRelease" },
    "reconciliations": {
      "type": "array",
      "items": { "$ref": "#/$defs/hostRestartReconciliationReceipt" }
    },
    "recoveries": {
      "type": "array",
      "items": { "$ref": "#/$defs/interruptedActivationRecoveryReceipt" }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptId", "sequence", "targetSha", "releaseContractDigest", "environmentPolicyDigest", "phase", "outcome", "events"],
      "properties": {
        "attemptId": { "$ref": "#/$defs/uuid" },
        "sequence": { "type": "integer", "minimum": 1 },
        "targetSha": { "$ref": "#/$defs/sha" },
        "releaseContractDigest": { "$ref": "#/$defs/digest" },
        "environmentPolicyDigest": { "$ref": "#/$defs/digest" },
        "phase": {
          "enum": ["requested", "building", "candidate-ready", "waiting-db-gate", "activating", "attesting", "committing", "restoring", "complete", "failed", "recovery-required"]
        },
        "outcome": { "enum": ["pending", "succeeded", "failed"] },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sequence", "at", "type"],
            "properties": {
              "sequence": { "type": "integer", "minimum": 1 },
              "at": { "$ref": "#/$defs/timestamp" },
              "type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
              "evidenceDigest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "uuid": { "type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$" },
    "bootId": { "type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestedAt", "sourceSha", "runtimeSha", "internalHealth", "publicHealth", "evidenceDigest"],
      "properties": {
        "attestedAt": { "$ref": "#/$defs/timestamp" },
        "sourceSha": { "$ref": "#/$defs/sha" },
        "runtimeSha": { "$ref": "#/$defs/sha" },
        "internalHealth": { "const": "pass" },
        "publicHealth": { "const": "pass" },
        "evidenceDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "hostRestartReconciliationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "reason", "priorGeneration", "newGeneration", "releaseSha", "releasePath", "oldHandleDigest", "newHandleDigest", "oldBootId", "currentBootId", "configurationDigests", "healthResult", "healthEvidenceDigest", "reconciledAt", "receiptDigest"],
      "properties": {
        "apiVersion": { "const": "quanyu.ai/host-restart-reconciliation-receipt/v1alpha1" },
        "kind": { "const": "HostRestartReconciliationReceipt" },
        "reason": { "const": "host-restart" },
        "priorGeneration": { "type": "integer", "minimum": 1 },
        "newGeneration": { "type": "integer", "minimum": 2 },
        "releaseSha": { "$ref": "#/$defs/sha" },
        "releasePath": { "type": "string", "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._@+/-]+$" },
        "oldHandleDigest": { "$ref": "#/$defs/digest" },
        "newHandleDigest": { "$ref": "#/$defs/digest" },
        "oldBootId": { "$ref": "#/$defs/bootId" },
        "currentBootId": { "$ref": "#/$defs/bootId" },
        "configurationDigests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["releaseContract", "environmentPolicy", "build", "runtime"],
          "properties": {
            "releaseContract": { "$ref": "#/$defs/digest" },
            "environmentPolicy": { "$ref": "#/$defs/digest" },
            "build": { "$ref": "#/$defs/digest" },
            "runtime": { "$ref": "#/$defs/digest" }
          }
        },
        "healthResult": { "const": "pass" },
        "healthEvidenceDigest": { "$ref": "#/$defs/digest" },
        "reconciledAt": { "$ref": "#/$defs/timestamp" },
        "receiptDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "interruptedActivationRecoveryReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "reason", "priorGeneration", "newGeneration", "failedAttemptDigest", "targetSha", "restoredSha", "orphanRecordDigest", "launchTokenDigest", "restoredHandleDigest", "configurationDigests", "healthEvidenceDigest", "recoveredAt", "receiptDigest"],
      "properties": {
        "apiVersion": { "const": "quanyu.ai/interrupted-activation-recovery-receipt/v1alpha1" },
        "kind": { "const": "InterruptedActivationRecoveryReceipt" },
        "reason": { "const": "candidate-start-orphan" },
        "priorGeneration": { "type": "integer", "minimum": 1 },
        "newGeneration": { "type": "integer", "minimum": 2 },
        "failedAttemptDigest": { "$ref": "#/$defs/digest" },
        "targetSha": { "$ref": "#/$defs/sha" },
        "restoredSha": { "$ref": "#/$defs/sha" },
        "orphanRecordDigest": { "$ref": "#/$defs/digest" },
        "launchTokenDigest": { "$ref": "#/$defs/digest" },
        "restoredHandleDigest": { "$ref": "#/$defs/digest" },
        "configurationDigests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["releaseContract", "environmentPolicy", "build", "runtime"],
          "properties": {
            "releaseContract": { "$ref": "#/$defs/digest" },
            "environmentPolicy": { "$ref": "#/$defs/digest" },
            "build": { "$ref": "#/$defs/digest" },
            "runtime": { "$ref": "#/$defs/digest" }
          }
        },
        "healthEvidenceDigest": { "$ref": "#/$defs/digest" },
        "recoveredAt": { "$ref": "#/$defs/timestamp" },
        "receiptDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "verifiedRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "releaseSha", "releasePath", "restorable", "handle", "attestation"],
      "properties": {
        "generation": { "type": "integer", "minimum": 1 },
        "releaseSha": { "$ref": "#/$defs/sha" },
        "releasePath": { "type": "string", "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._@+/-]+$" },
        "restorable": { "const": true },
        "handle": { "$ref": "https://quanyu.ai/schemas/process-handle/v1alpha1" },
        "attestation": { "$ref": "#/$defs/attestation" }
      }
    }
  }
}
