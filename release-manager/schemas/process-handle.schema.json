{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanyu.ai/schemas/process-handle/v1alpha1",
  "title": "Opaque ProcessHandle persistence representation",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "adapter", "identity", "runtime", "releaseSha", "invocationFingerprint", "provenance"],
  "properties": {
    "apiVersion": { "const": "quanyu.ai/process-handle/v1alpha1" },
    "kind": { "const": "ProcessHandle" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "instanceId"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "instanceId": { "$ref": "#/$defs/uuid" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environmentId", "serviceId", "namespace", "adapterId", "pid", "processStartId"],
      "properties": {
        "environmentId": { "$ref": "#/$defs/id" },
        "serviceId": { "$ref": "#/$defs/id" },
        "namespace": { "$ref": "#/$defs/id" },
        "adapterId": { "type": "string", "minLength": 1 },
        "pid": { "type": "integer", "minimum": 1 },
        "processStartId": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args", "cwd"],
      "properties": {
        "executable": { "$ref": "#/$defs/absolutePath" },
        "args": { "type": "array", "maxItems": 64, "items": { "type": "string" } },
        "cwd": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "releaseSha": { "$ref": "#/$defs/sha" },
    "invocationFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "configurationDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "runtime"],
      "properties": {
        "build": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "runtime": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "legacyRestoreDescriptorDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "observationId", "observedAt", "adapterReceipt"],
      "properties": {
        "origin": { "enum": ["observed", "started"] },
        "observationId": { "$ref": "#/$defs/uuid" },
        "observedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "adapterReceipt": { "type": "string", "minLength": 16 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "uuid": { "type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$" },
    "absolutePath": { "type": "string", "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._@+/-]+$" }
  }
}
