{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanyu.ai/schemas/release-contract/v1alpha1",
  "title": "Repository Release Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "toolchain", "lifecycle", "artifact", "runtime", "health", "migration"],
  "properties": {
    "apiVersion": { "const": "quanyu.ai/release-contract/v1alpha1" },
    "kind": { "const": "ReleaseContract" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application"],
      "properties": {
        "application": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "packageManager", "install"],
      "properties": {
        "node": { "$ref": "#/$defs/sourceReference" },
        "packageManager": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "runner"],
          "properties": {
            "source": { "const": "package.json#packageManager" },
            "runner": { "const": "corepack" }
          }
        },
        "install": { "$ref": "#/$defs/action" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "verify"],
      "properties": {
        "prepare": { "$ref": "#/$defs/actionWithOutputs" },
        "build": { "$ref": "#/$defs/action" },
        "verify": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" },
          "maxItems": 32
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appRoot", "required", "trackedMutationAllowlist"],
      "properties": {
        "appRoot": { "$ref": "#/$defs/relativePath" },
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "trackedMutationAllowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cwd", "executable", "args", "envNames", "binding"],
      "properties": {
        "cwd": { "$ref": "#/$defs/relativePath" },
        "executable": { "$ref": "#/$defs/relativePath" },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/safeArg" }
        },
        "envNames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/envName" }
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostEnv", "portEnv"],
          "properties": {
            "hostEnv": { "$ref": "#/$defs/envName" },
            "portEnv": { "$ref": "#/$defs/envName" }
          }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "acceptedStatusClasses"],
      "properties": {
        "path": { "type": "string", "pattern": "^/[A-Za-z0-9_./-]*$" },
        "acceptedStatusClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 2, "maximum": 3 }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["none", "approval-gated"] }
      }
    }
  },
  "$defs": {
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "enum": ["package.json#engines.node", ".nvmrc", ".node-version"] }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._@+/-]+$"
    },
    "envName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "safeArg": {
      "type": "string",
      "pattern": "^(?!.*(?:\\$\\{|\\$\\(|`|[;&|<>]|[\\r\\n])).*$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/safeArg" }
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["argv"],
          "properties": { "argv": { "$ref": "#/$defs/argv" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["packageScript"],
          "properties": { "packageScript": { "type": "string", "pattern": "^[a-zA-Z0-9:_-]+$" } }
        }
      ]
    },
    "actionWithOutputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "outputs"],
      "properties": {
        "action": { "$ref": "#/$defs/action" },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    }
  }
}
