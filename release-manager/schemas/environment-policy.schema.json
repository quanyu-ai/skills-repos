{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanyu.ai/schemas/environment-policy/v1alpha1",
  "title": "External Environment Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "storage", "process", "network", "secrets", "health", "retention"],
  "properties": {
    "apiVersion": { "const": "quanyu.ai/environment-policy/v1alpha1" },
    "kind": { "const": "EnvironmentPolicy" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environmentId", "serviceId", "application"],
      "properties": {
        "environmentId": { "$ref": "#/$defs/id" },
        "serviceId": { "$ref": "#/$defs/id" },
        "application": { "$ref": "#/$defs/id" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseRoot", "stateRoot", "lockFile"],
      "properties": {
        "releaseRoot": { "$ref": "#/$defs/absolutePath" },
        "stateRoot": { "$ref": "#/$defs/absolutePath" },
        "lockFile": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "namespace", "stableName", "replacement"],
      "properties": {
        "adapter": { "const": "pm2" },
        "namespace": { "$ref": "#/$defs/id" },
        "stableName": { "$ref": "#/$defs/id" },
        "replacement": { "const": "stop-absent-start-attest" }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internalHost", "internalPort", "publicBaseUrl"],
      "properties": {
        "internalHost": { "enum": ["127.0.0.1", "::1"] },
        "internalPort": { "$ref": "#/$defs/port" },
        "publicBaseUrl": { "type": "string", "pattern": "^https?://[^/@:]+(?::[0-9]{1,5})?$" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "sourcePath", "requiredNames"],
      "properties": {
        "provider": { "const": "external-json-file" },
        "sourcePath": { "$ref": "#/$defs/absolutePath" },
        "requiredNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "intervalMs"],
      "properties": {
        "attempts": { "type": "integer", "minimum": 1, "maximum": 120 },
        "intervalMs": { "type": "integer", "minimum": 100, "maximum": 60000 }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifiedReleases", "failedAttempts"],
      "properties": {
        "verifiedReleases": { "type": "integer", "minimum": 2, "maximum": 50 },
        "failedAttempts": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "absolutePath": {
      "type": "string",
      "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._@+/-]+$"
    }
  }
}
